#!/bin/sh
# Avvio col doppio clic dal Finder (macOS). Sostituisce MeshRec.command.
#
# Un bundle .app non apre il Terminale: la cartella corrente e' la home, nessuno
# legge stdout. Quindi: cd nella cartella del programma (tre livelli sopra il
# bundle), l'uscita nel log dell'utente, e gli errori in un dialogo.
cd "$(dirname "$0")/../../.." || exit 1

if [ ! -f pyproject.toml ]; then
    osascript -e 'display dialog "MeshRec.app va avviato dalla cartella meshrec/ del progetto, non da Applicazioni: rimettilo lì e riapri." with title "MeshRec" buttons {"OK"} default button 1 with icon stop'
    exit 1
fi

PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH
LOG="$HOME/Library/Logs/MeshRec.log"
mkdir -p "$(dirname "$LOG")"

if ! command -v uv >/dev/null 2>&1; then
    osascript -e 'display dialog "uv non trovato. Installalo con:\n\ncurl -LsSf https://astral.sh/uv/install.sh | sh\n\ne riapri MeshRec." with title "MeshRec" buttons {"OK"} default button 1 with icon stop'
    exit 1
fi

# Il codice d'uscita si cattura (`if ! uv run ...` lo perdeva) e decide il
# dialogo. 129/137/143 = SIGHUP/SIGKILL/SIGTERM: qualcun altro ha chiuso il
# programma (il 12/09/2026 un `pkill` esterno, scambiato per un errore di
# MeshRec). 134/139 = SIGABRT/SIGSEGV: crash. Il resto: errore del programma.
uv run meshrec serve "$@" >>"$LOG" 2>&1
codice=$?
if [ "$codice" -ne 0 ]; then
    echo "MeshRec uscito con codice $codice" >>"$LOG"
    case "$codice" in
        129|137|143) motivo="MeshRec è stato chiuso da un altro processo (codice $codice), non da un errore del programma: puoi riaprirlo normalmente." ;;
        134|139) motivo="MeshRec si è chiuso di colpo per un errore interno (codice $codice)." ;;
        *) motivo="MeshRec si è fermato con un errore (codice $codice)." ;;
    esac
    osascript -e "display dialog \"$motivo Le ultime righe sono in:\n$LOG\" with title \"MeshRec\" buttons {\"OK\"} default button 1 with icon stop"
    exit "$codice"
fi
